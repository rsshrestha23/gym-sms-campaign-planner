# One image for every server deployable (API, dispatcher, outbox relay, workers, mock provider);
# each service picks its entry point with `command`.
FROM node:22-alpine
WORKDIR /app
COPY package.json package-lock.json ./
COPY packages/api/package.json packages/api/
COPY packages/dispatcher/package.json packages/dispatcher/
COPY packages/workers/package.json packages/workers/
COPY packages/web/package.json packages/web/
# Dev dependencies stay installed so `npm run seed|reset|simulate|demo:live` work via `docker compose exec`.
RUN npm ci --workspace @gym/api --workspace @gym/dispatcher --workspace @gym/workers --include-workspace-root
COPY tsconfig.server.json ./
COPY packages/api packages/api
COPY packages/dispatcher packages/dispatcher
COPY packages/workers packages/workers
RUN npm run build:server
ENV NODE_ENV=production
USER node
EXPOSE 3000
CMD ["node", "build/api/src/server.js"]
