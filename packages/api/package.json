{
  "name": "@gym/api",
  "private": true,
  "version": "1.0.0",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').cpSync('src/db/migrations','dist/db/migrations',{recursive:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "migrate": "tsx src/db/migrate-cli.ts",
    "seed": "tsx src/seed/seed-cli.ts",
    "reset": "tsx src/seed/reset.ts",
    "simulate": "tsx src/simulator/simulate.ts",
    "demo:live": "tsx src/seed/live-demo.ts",
    "load:plan": "tsx test/load/plan-5m-members.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/instrumentation-express": "^0.72.0",
    "@opentelemetry/instrumentation-http": "^0.300.0",
    "@opentelemetry/instrumentation-ioredis": "^0.72.0",
    "@opentelemetry/instrumentation-pg": "^0.77.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "bullmq": "^5.81.5",
    "express": "^5.3.0",
    "ioredis": "^5.11.1",
    "luxon": "^3.7.2",
    "pg": "^8.23.1",
    "pg-copy-streams": "^6.0.6",
    "prom-client": "^15.1.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/luxon": "^3.7.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/pg-copy-streams": "^1.2.5",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
